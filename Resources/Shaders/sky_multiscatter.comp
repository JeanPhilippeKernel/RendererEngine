#version 460
#extension GL_GOOGLE_include_directive : require
#include "texture_bindings.glsl"
// Bruneton 2008 / Hillaire 2020 — multiple scattering LUT, 32x32 RGBA16F

layout(local_size_x = 1, local_size_y = 1, local_size_z = 64) in;

layout(set = 2, binding = 0, rgba16f) uniform writeonly image2D o_multiscatter;

layout(set = 0, binding = 1) uniform UBAtmosphere
{
    vec4  RayleighScattering;
    vec4  MieScattering;
    vec4  MieAbsorption;
    vec4  OzoneAbsorption;
    float PlanetRadius;
    float AtmosphereRadius;
    float RayleighScaleHeight;
    float MieScaleHeight;
    float MieAnisotropy;
    float OzoneLayerCentre;
    float OzoneLayerWidth;
    float SunIlluminanceScale;
    vec4  SunDirection;
    float SunAngularRadius;
    float _pad0_a;
    float _pad0_b;
    float _pad0_c;
    vec4  CameraPositionKm;
    uint  TransmittanceLUTIndex;
    uint  MultiscatterLUTIndex;
    uint  SkyviewLUTIndex;
    float _pad1;
};

shared vec3 s_lum[64];
shared vec3 s_f_ms[64];

vec3        GetTransmittance(float altitude, float cos_view)
{
    float h = clamp((altitude - PlanetRadius) / (AtmosphereRadius - PlanetRadius), 0.0, 1.0);
    return texture(sampler2D(TextureArray[TransmittanceLUTIndex], LinearClampSampler), vec2(cos_view * 0.5 + 0.5, h)).rgb;
};

vec2 RaySphereIntersect(vec3 o, vec3 d, float r)
{
    float b = dot(o, d), c = dot(o, o) - r * r, det = b * b - c;
    if (det < 0.0)
        return vec2(-1.0);
    float sq = sqrt(det);
    return vec2(-b - sq, -b + sq);
};
vec3 Scattering(float alt_m)
{
    float h = alt_m - PlanetRadius;
    return RayleighScattering.rgb * exp(-h / RayleighScaleHeight) + MieScattering.rgb * exp(-h / MieScaleHeight);
};
vec3 Extinction(float alt_m)
{
    float h  = alt_m - PlanetRadius;
    float rd = exp(-h / RayleighScaleHeight), md = exp(-h / MieScaleHeight);
    float od = max(0.0, 1.0 - abs(h - OzoneLayerCentre) / (OzoneLayerWidth * 0.5));
    return RayleighScattering.rgb * rd + (MieScattering.rgb + MieAbsorption.rgb) * md + OzoneAbsorption.rgb * od;
};

void main()
{
    ivec2 coord = ivec2(gl_WorkGroupID.xy);
    ivec2 size  = imageSize(o_multiscatter);
    uint  tid   = gl_LocalInvocationID.z;
    if (coord.x >= size.x || coord.y >= size.y)
        return;
    vec2  uv       = (vec2(coord) + 0.5) / vec2(size);
    float altitude = PlanetRadius + uv.y * (AtmosphereRadius - PlanetRadius);
    float cos_sun  = uv.x * 2.0 - 1.0;
    float phi      = (float(tid) + 0.5) / 64.0 * 6.2831853;
    float ct       = float(tid) * 2.0 / 64.0 - 1.0 + 1.0 / 64.0;
    float st       = sqrt(max(0.0, 1.0 - ct * ct));
    vec3  dir      = vec3(st * cos(phi), ct, st * sin(phi));
    vec3  pos      = vec3(0.0, altitude, 0.0);
    vec2  at       = RaySphereIntersect(pos, dir, AtmosphereRadius);
    float t_max    = max(at.x, at.y);
    if (t_max < 0.0)
        t_max = 0.0;
    vec2 pt = RaySphereIntersect(pos, dir, PlanetRadius);
    if (pt.x > 0.0)
        t_max = min(t_max, pt.x);
    float step = t_max / 20.0;
    vec3  lum = vec3(0.0), f_ms = vec3(0.0), thru = vec3(1.0);
    vec3  sun = normalize(vec3(sqrt(1.0 - cos_sun * cos_sun), cos_sun, 0.0));
    for (int i = 0; i < 20; ++i)
    {
        float t      = (float(i) + 0.5) * step;
        vec3  sp     = pos + dir * t;
        float alt    = length(sp);
        vec3  T_sun  = GetTransmittance(alt, dot(normalize(sp), sun));
        vec3  sg     = Scattering(alt);
        vec3  ext    = Extinction(alt);
        lum         += thru * sg * T_sun * (1.0 / (4.0 * 3.14159265)) * step;
        f_ms        += thru * sg * (1.0 / (4.0 * 3.14159265)) * step;
        thru        *= exp(-ext * step);
    }
    s_lum[tid]  = lum;
    s_f_ms[tid] = f_ms;
    barrier();
    for (uint s = 32; s > 0; s >>= 1)
    {
        if (tid < s)
        {
            s_lum[tid]  += s_lum[tid + s];
            s_f_ms[tid] += s_f_ms[tid + s];
        }
        barrier();
    }
    if (tid == 0)
    {
        vec3 fms = s_f_ms[0] / 64.0, lv = s_lum[0] / 64.0;
        imageStore(o_multiscatter, coord, vec4(lv / max(vec3(1e-7), vec3(1.0) - fms), 1.0));
    }
};
