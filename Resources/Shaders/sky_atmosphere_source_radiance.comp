#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D Transmittance;
layout(set = 0, binding = 1) uniform texture2D Multiscattering;
layout(set = 0, binding = 2) uniform sampler LinearClampToEdgeSampler;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2DArray Destination;

layout(push_constant) uniform AtmosphereSourceRadiancePushConstants
{
    vec4 RadiiAndScaleHeights;
    vec4 RayleighScattering;
    vec4 MieAndOzone;
    vec4 OzoneAbsorption;
    vec4 SunDirectionAndRadius;
    vec4 SunRadianceAvailabilityAndCaptureAltitude;
    vec4 GroundAlbedoAndAmbient;
}
Push;

#define SKY_ATMOSPHERE_TRANSMITTANCE_LUT   sampler2D(Transmittance, LinearClampToEdgeSampler)
#define SKY_ATMOSPHERE_MULTISCATTERING_LUT sampler2D(Multiscattering, LinearClampToEdgeSampler)
#include "sky_atmosphere_integrator.glsl"

// This is the engine's canonical cubemap convention. It matches the environment
// mip, irradiance, and specular shaders, so every environment consumer agrees on
// the direction represented by each face texel.
vec3 cube_direction(uint face, vec2 uv)
{
    if (face == 0u)
        return normalize(vec3(1.0, -uv.y, -uv.x));
    if (face == 1u)
        return normalize(vec3(-1.0, -uv.y, uv.x));
    if (face == 2u)
        return normalize(vec3(uv.x, 1.0, uv.y));
    if (face == 3u)
        return normalize(vec3(uv.x, -1.0, -uv.y));
    if (face == 4u)
        return normalize(vec3(uv.x, -uv.y, 1.0));
    return normalize(vec3(-uv.x, -uv.y, -1.0));
}

void main()
{
    const uvec2 pixel  = gl_GlobalInvocationID.xy;
    const uint  face   = gl_GlobalInvocationID.z;
    const ivec3 extent = imageSize(Destination);
    if (pixel.x >= uint(extent.x) || pixel.y >= uint(extent.y) || face >= uint(extent.z))
        return;

    const vec2              uv               = ((vec2(pixel) + vec2(0.5)) / vec2(extent.xy)) * 2.0 - 1.0;
    const vec3              view_direction   = cube_direction(face, uv);
    const float             sun_length       = length(Push.SunDirectionAndRadius.xyz);
    const bool              has_sun          = Push.SunRadianceAvailabilityAndCaptureAltitude.y > 0.5 && sun_length > 1.0e-6;
    const vec3              sun_direction    = has_sun ? Push.SunDirectionAndRadius.xyz / sun_length : vec3(0.0, 1.0, 0.0);
    const float             sun_cosine       = has_sun ? dot(view_direction, sun_direction) : -1.0;
    const float             sun_radius       = clamp(Push.SunDirectionAndRadius.w, 0.0, 0.25);
    const float             sun_threshold    = cos(sun_radius);
    const float             sun_disc         = has_sun && sun_radius > 0.0 ? smoothstep(sun_threshold, 1.0, sun_cosine) : 0.0;
    const float             sun_radiance     = has_sun ? max(Push.SunRadianceAvailabilityAndCaptureAltitude.x, 0.0) : 0.0;
    const float             capture_altitude = clamp(Push.SunRadianceAvailabilityAndCaptureAltitude.z, 0.0, max(Push.RadiiAndScaleHeights.y - Push.RadiiAndScaleHeights.x, 0.0));
    const vec3              camera_position  = vec3(0.0, Push.RadiiAndScaleHeights.x + capture_altitude, 0.0);
    SkyAtmosphereParameters parameters;
    parameters.RadiiAndScaleHeights               = Push.RadiiAndScaleHeights;
    parameters.RayleighScatteringAndGroundAlbedoR = vec4(Push.RayleighScattering.rgb, Push.GroundAlbedoAndAmbient.x);
    parameters.MieAndOzone                        = Push.MieAndOzone;
    parameters.OzoneAbsorption                    = Push.OzoneAbsorption;
    parameters.GroundAlbedoAndAmbient             = Push.GroundAlbedoAndAmbient;
    vec3       transmittance_to_boundary;
    const vec3 sky_radiance  = sky_integrate_radiance_segment(parameters, camera_position, view_direction, sun_direction, sun_radiance, -1.0, transmittance_to_boundary);
    const vec3 disc_radiance = sky_sample_sun_transmittance(camera_position, sun_direction, parameters.RadiiAndScaleHeights) * sun_radiance * sun_disc;
    imageStore(Destination, ivec3(pixel, face), vec4(clamp(sky_radiance + disc_radiance, vec3(0.0), vec3(65000.0)), 1.0));
}
