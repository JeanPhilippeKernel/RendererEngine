#version 460
// Bruneton 2008 / Hillaire 2020 — transmittance LUT
// Output: 256x64 R11G11B10_UFLOAT
// No sampler input — first LUT in the chain.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 2, binding = 0, r11f_g11f_b10f) uniform writeonly image2D o_transmittance;

layout(set = 0, binding = 1) uniform UBAtmosphere
{
    vec4  RayleighScattering;
    vec4  MieScattering;
    vec4  MieAbsorption;
    vec4  OzoneAbsorption;
    float PlanetRadius;
    float AtmosphereRadius;
    float RayleighScaleHeight;
    float MieScaleHeight;
    float MieAnisotropy;
    float OzoneLayerCentre;
    float OzoneLayerWidth;
    float SunIlluminanceScale;
    vec4  SunDirection;
    float SunAngularRadius;
    float _pad0[3];
    vec4  CameraPositionKm;
    uint  TransmittanceLUTIndex;
    uint  MultiscatterLUTIndex;
    uint  SkyviewLUTIndex;
    float _pad1;
}
Atmo;

vec2 RaySphereIntersect(vec3 o, vec3 d, float r)
{
    float b = dot(o, d), c = dot(o, o) - r * r, det = b * b - c;
    if (det < 0.0)
        return vec2(-1.0);
    float sq = sqrt(det);
    return vec2(-b - sq, -b + sq);
}

vec3 Extinction(float alt_m)
{
    float h  = alt_m - Atmo.PlanetRadius;
    float rd = exp(-h / Atmo.RayleighScaleHeight);
    float md = exp(-h / Atmo.MieScaleHeight);
    float od = max(0.0, 1.0 - abs(h - Atmo.OzoneLayerCentre) / (Atmo.OzoneLayerWidth * 0.5));
    return Atmo.RayleighScattering.rgb * rd + (Atmo.MieScattering.rgb + Atmo.MieAbsorption.rgb) * md + Atmo.OzoneAbsorption.rgb * od;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(o_transmittance);
    if (coord.x >= size.x || coord.y >= size.y)
        return;

    vec2  uv       = (vec2(coord) + 0.5) / vec2(size);
    float cos_view = uv.x * 2.0 - 1.0;
    float altitude = Atmo.PlanetRadius + uv.y * (Atmo.AtmosphereRadius - Atmo.PlanetRadius);

    vec3  pos      = vec3(0.0, altitude, 0.0);
    vec3  dir      = vec3(sqrt(max(0.0, 1.0 - cos_view * cos_view)), cos_view, 0.0);
    vec2  at       = RaySphereIntersect(pos, dir, Atmo.AtmosphereRadius);
    float t_max    = max(at.x, at.y);
    if (t_max <= 0.0)
    {
        imageStore(o_transmittance, coord, vec4(1.0));
        return;
    }
    vec2 pt = RaySphereIntersect(pos, dir, Atmo.PlanetRadius);
    if (pt.x > 0.0)
        t_max = min(t_max, pt.x);

    vec3  od   = vec3(0.0);
    float step = t_max / 40.0;
    for (int i = 0; i < 40; ++i)
        od += Extinction(length(pos + dir * ((float(i) + 0.5) * step))) * step;

    imageStore(o_transmittance, coord, vec4(exp(-od), 1.0));
}
