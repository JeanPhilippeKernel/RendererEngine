#version 460
// Bruneton 2008 / Hillaire 2020 — transmittance LUT
// Output: 256x64 R11G11B10_UFLOAT
//   x-axis: cos(view-zenith angle) remapped to [0,1]
//   y-axis: altitude in atmosphere [0,1]
// Each texel stores exp(-integral of extinction along ray to top of atmosphere).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0, r11f_g11f_b10f) uniform writeonly image2D o_transmittance;

layout(set = 0, binding = 1) uniform UBAtmosphere
{
    vec4  RayleighScattering;
    vec4  MieScattering;
    vec4  MieAbsorption;
    vec4  OzoneAbsorption;
    float PlanetRadius;
    float AtmosphereRadius;
    float RayleighScaleHeight;
    float MieScaleHeight;
    float MieAnisotropy;
    float OzoneLayerCentre;
    float OzoneLayerWidth;
    float SunIlluminanceScale;
    vec4  SunDirection;
    float SunAngularRadius;
    float _pad0[3];
    vec4  CameraPositionKm;
    float _pad1[4];
}
Atmo;

// Map texel coord to (altitude h, cos theta_view)
void TexcoordToAtmosphere(vec2 uv, out float altitude, out float cos_view)
{
    cos_view     = uv.x * 2.0 - 1.0;
    float h_norm = uv.y;
    float h_bot  = Atmo.PlanetRadius;
    float h_top  = Atmo.AtmosphereRadius;
    altitude     = h_bot + h_norm * (h_top - h_bot);
}

// Ray-sphere intersection (returns distances; negative = behind)
vec2 RaySphereIntersect(vec3 origin, vec3 dir, float radius)
{
    float b   = dot(origin, dir);
    float c   = dot(origin, origin) - radius * radius;
    float det = b * b - c;
    if (det < 0.0)
        return vec2(-1.0);
    float sq = sqrt(det);
    return vec2(-b - sq, -b + sq);
}

// Extinction coefficient at altitude h (km above planet centre in metres)
vec3 Extinction(float altitude_m)
{
    float h                = altitude_m - Atmo.PlanetRadius;
    float rayleigh_density = exp(-h / Atmo.RayleighScaleHeight);
    float mie_density      = exp(-h / Atmo.MieScaleHeight);
    float ozone_density    = max(0.0, 1.0 - abs(h - Atmo.OzoneLayerCentre) / (Atmo.OzoneLayerWidth * 0.5));

    vec3  rayleigh_ext     = Atmo.RayleighScattering.rgb * rayleigh_density;
    vec3  mie_ext          = (Atmo.MieScattering.rgb + Atmo.MieAbsorption.rgb) * mie_density;
    vec3  ozone_ext        = Atmo.OzoneAbsorption.rgb * ozone_density;
    return rayleigh_ext + mie_ext + ozone_ext;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(o_transmittance);
    if (coord.x >= size.x || coord.y >= size.y)
        return;

    vec2  uv = (vec2(coord) + 0.5) / vec2(size);
    float altitude, cos_view;
    TexcoordToAtmosphere(uv, altitude, cos_view);

    vec3  pos    = vec3(0.0, altitude, 0.0);
    vec3  dir    = vec3(sqrt(1.0 - cos_view * cos_view), cos_view, 0.0);
    vec2  atmo_t = RaySphereIntersect(pos, dir, Atmo.AtmosphereRadius);
    float t_max  = atmo_t.y;
    if (t_max <= 0.0)
    {
        imageStore(o_transmittance, coord, vec4(1.0, 1.0, 1.0, 1.0));
        return;
    }
    // Early exit if ray hits planet
    vec2 planet_t = RaySphereIntersect(pos, dir, Atmo.PlanetRadius);
    if (planet_t.x > 0.0)
        t_max = min(t_max, planet_t.x);

    // Numerical integration — 40 steps
    const int STEPS         = 40;
    float     step_size     = t_max / float(STEPS);
    vec3      optical_depth = vec3(0.0);
    for (int i = 0; i < STEPS; ++i)
    {
        float t           = (float(i) + 0.5) * step_size;
        vec3  sample_pos  = pos + dir * t;
        float alt         = length(sample_pos);
        optical_depth    += Extinction(alt) * step_size;
    }

    vec3 transmittance = exp(-optical_depth);
    imageStore(o_transmittance, coord, vec4(transmittance, 1.0));
}
