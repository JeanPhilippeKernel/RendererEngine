#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform textureCube SourceRadiance;
layout(set = 0, binding = 1) uniform sampler LinearClampToEdgeSampler;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2DArray Destinations[16];

layout(push_constant) uniform SpecularPrefilterPushConstants
{
    uint  Resolution;
    uint  MipLevel;
    uint  SampleCount;
    uint  SourceMipCount;
    float Roughness;
    vec3  Padding;
}
Push;

const float PI = 3.14159265358979323846;

float       radical_inverse_vdc(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint index, uint count)
{
    return vec2(float(index) / float(count), radical_inverse_vdc(index));
}

vec3 cube_direction(uint face, vec2 uv)
{
    if (face == 0u)
        return normalize(vec3(1.0, -uv.y, -uv.x));
    if (face == 1u)
        return normalize(vec3(-1.0, -uv.y, uv.x));
    if (face == 2u)
        return normalize(vec3(uv.x, 1.0, uv.y));
    if (face == 3u)
        return normalize(vec3(uv.x, -1.0, -uv.y));
    if (face == 4u)
        return normalize(vec3(uv.x, -uv.y, 1.0));
    return normalize(vec3(-uv.x, -uv.y, -1.0));
}

vec3 importance_sample_ggx(vec2 xi, vec3 normal, float roughness)
{
    const float alpha       = roughness * roughness;
    const float phi         = 2.0 * PI * xi.x;
    const float cos_theta   = sqrt((1.0 - xi.y) / max(1.0 + (alpha * alpha - 1.0) * xi.y, 1e-5));
    const float sin_theta   = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
    const vec3  half_vector = vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
    const vec3  up_axis     = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3  tangent     = normalize(cross(up_axis, normal));
    const vec3  bitangent   = cross(normal, tangent);
    return normalize(tangent * half_vector.x + bitangent * half_vector.y + normal * half_vector.z);
}

float distribution_ggx(vec3 normal, vec3 half_vector, float roughness)
{
    const float alpha    = roughness * roughness;
    const float alpha_sq = alpha * alpha;
    const float n_dot_h  = max(dot(normal, half_vector), 0.0);
    const float denom    = n_dot_h * n_dot_h * (alpha_sq - 1.0) + 1.0;
    return alpha_sq / max(PI * denom * denom, 1e-5);
}

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uint  face  = gl_GlobalInvocationID.z;
    if (pixel.x >= Push.Resolution || pixel.y >= Push.Resolution || face >= 6u)
        return;

    const vec2 view_uv  = ((vec2(pixel) + vec2(0.5)) / float(Push.Resolution)) * 2.0 - 1.0;
    const vec3 normal   = cube_direction(face, view_uv);
    const vec3 view     = normal;
    vec3       filtered = vec3(0.0);
    float      weight   = 0.0;

    for (uint sample_index = 0u; sample_index < Push.SampleCount; ++sample_index)
    {
        const vec3  half_vector = importance_sample_ggx(hammersley(sample_index, Push.SampleCount), normal, max(Push.Roughness, 0.001));
        const vec3  light       = normalize(2.0 * dot(view, half_vector) * half_vector - view);
        const float n_dot_l     = max(dot(normal, light), 0.0);
        if (n_dot_l <= 0.0)
            continue;

        const float n_dot_h       = max(dot(normal, half_vector), 0.0);
        const float h_dot_v       = max(dot(half_vector, view), 0.0);
        const float pdf           = max(distribution_ggx(normal, half_vector, Push.Roughness) * n_dot_h / max(4.0 * h_dot_v, 1e-5), 1e-5);
        const float texel_solid   = 4.0 * PI / (6.0 * float(Push.Resolution * Push.Resolution));
        const float sample_solid  = 1.0 / (float(Push.SampleCount) * pdf + 1e-5);
        const float lod           = Push.Roughness <= 0.0 ? 0.0 : clamp(0.5 * log2(sample_solid / texel_solid), 0.0, float(Push.SourceMipCount - 1u));
        filtered                 += textureLod(samplerCube(SourceRadiance, LinearClampToEdgeSampler), light, lod).rgb * n_dot_l;
        weight                   += n_dot_l;
    }

    filtered /= max(weight, 1e-5);
    imageStore(Destinations[Push.MipLevel], ivec3(pixel, face), vec4(filtered, 1.0));
}
