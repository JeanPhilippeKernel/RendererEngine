<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Panzerfaust.Views"
        x:DataType="local:ConfirmDialogModel"
        x:Class="Panzerfaust.Views.ConfirmDialog"
        Title="Confirm"
        Width="400" Height="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        Background="{DynamicResource SidebarBackground}">

  <Grid RowDefinitions="*, Auto" Margin="24,20,24,20">

    <TextBlock Grid.Row="0"
               Text="{Binding Message}"
               FontSize="13"
               TextWrapping="Wrap"
               VerticalAlignment="Center"/>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel"
              Width="90"
              HorizontalContentAlignment="Center"
              Background="{DynamicResource SettingsGroupBackground}"
              CornerRadius="6"
              Click="OnCancel"/>
      <Button Content="{Binding ConfirmLabel}"
              Width="100"
              HorizontalContentAlignment="Center"
              Background="#C42B1C" Foreground="White"
              CornerRadius="6"
              Click="OnConfirm"/>
    </StackPanel>

  </Grid>
</Window>
