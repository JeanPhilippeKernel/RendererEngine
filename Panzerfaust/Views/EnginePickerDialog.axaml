<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Panzerfaust.ViewModels"
        x:DataType="vm:EnginePickerViewModel"
        x:Class="Panzerfaust.Views.EnginePickerDialog"
        Title="Open Project"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

  <Border Background="{DynamicResource SidebarBackground}"
          BorderBrush="{DynamicResource SettingsGroupBackground}"
          BorderThickness="1"
          CornerRadius="12"
          Margin="1">

    <StackPanel Margin="24,22,24,22" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Text="Select Engine" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis">
          <Run Text="Opening "/>
          <Run Text="{Binding ProjectName}" FontWeight="SemiBold"/>
        </TextBlock>
      </StackPanel>

      <Border Background="{DynamicResource SettingsGroupBackground}"
              CornerRadius="8" Padding="14,12"
              IsVisible="{Binding !HasEngines}">
        <TextBlock Text="No engines installed. Download one from Settings → Engine."
                   FontSize="12" TextWrapping="Wrap" Opacity="0.6"/>
      </Border>

      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Watermark="Search version…"
               BorderBrush="Transparent" BorderThickness="0"
               CornerRadius="6"
               IsVisible="{Binding HasEngines}"/>

      <ListBox ItemsSource="{Binding FilteredEngines}"
               SelectedItem="{Binding SelectedEngine}"
               Background="Transparent"
               BorderThickness="0"
               MaxHeight="240"
               IsVisible="{Binding HasEngines}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:InstalledEngineViewModel">
            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding BinaryPath}" FontSize="10" Opacity="0.4"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                      Background="#C07C00"
                      IsVisible="{Binding IsRc}">
                <TextBlock Text="RC" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Background="#33C07C00"
              BorderBrush="#C07C00" BorderThickness="1"
              CornerRadius="8" Padding="12,10"
              IsVisible="{Binding IsRcSelected}">
        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
          <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="#C07C00"
                     VerticalAlignment="Top" Margin="0,1,10,0"/>
          <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="#C07C00"
                     Text="You selected a Release Candidate. RC builds may be unstable and cause project corruption. Proceed with caution."/>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
        <Button Grid.Column="1"
                Content="Cancel"
                Width="90"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource SettingsGroupBackground}"
                CornerRadius="6" Padding="0,9"
                Margin="0,0,10,0"
                Click="OnCancel"/>
        <Button Grid.Column="2"
                Content="Open Project"
                Width="120"
                HorizontalContentAlignment="Center"
                Background="#0078D4" Foreground="White"
                CornerRadius="6" Padding="0,9"
                IsEnabled="{Binding CanOpen}"
                Click="OnOpen"/>
      </Grid>

    </StackPanel>
  </Border>

</Window>
