cmake_minimum_required(VERSION 3.23)

# Shared by CTest and installed-artifact CI; requires no source tree or shell.
if(NOT DEFINED HELPER)
    set(HELPER "${CMAKE_CURRENT_LIST_DIR}/SceneDocumentProcess${CMAKE_EXECUTABLE_SUFFIX}")
    if(CMAKE_HOST_WIN32)
        set(HELPER "${CMAKE_CURRENT_LIST_DIR}/SceneDocumentProcess.exe")
    endif()
endif()
if(NOT EXISTS "${HELPER}")
    message(FATAL_ERROR "Scene process helper not found: ${HELPER}")
endif()
if(NOT DEFINED TEST_ROOT)
    set(TEST_ROOT "${CMAKE_CURRENT_BINARY_DIR}/scene-process-tests")
endif()
if(NOT DEFINED ROOT_KIND)
    set(ROOT_KIND all)
endif()
if(ROOT_KIND STREQUAL "all")
    set(root_kinds plain unicode)
elseif(ROOT_KIND STREQUAL "plain" OR ROOT_KIND STREQUAL "unicode")
    set(root_kinds "${ROOT_KIND}")
else()
    message(FATAL_ERROR "Unknown ROOT_KIND: ${ROOT_KIND}")
endif()

function(run_child operation order root)
    execute_process(COMMAND "${HELPER}" "${operation}" "${order}" "${root}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Scene process ${operation}/${order} failed (${result}). Fixture retained at ${root}\n${output}\n${errors}")
    endif()
endfunction()

foreach(kind IN LISTS root_kinds)
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run_id)
    set(root "${TEST_ROOT}/run-${run_id}")
    if(kind STREQUAL "unicode")
        string(APPEND root " space é 東京 𠮷")
    endif()
    # Never reuse or recursively remove a pre-existing directory.
    if(EXISTS "${root}")
        message(FATAL_ERROR "Refusing to reuse scene test directory: ${root}")
    endif()
    file(MAKE_DIRECTORY "${root}")
    foreach(encoding yaml binary)
        if(encoding STREQUAL "binary")
            set(write_mode write-binary)
            set(read_mode read-binary)
            set(scene "${root}/scene.zescenebin")
            set(reopened "${root}/reopened.zescenebin")
        else()
            set(write_mode write)
            set(read_mode read)
            set(scene "${root}/scène_資料_𠮷.zescene")
            set(reopened "${root}/reopened.zescene")
        endif()
        run_child("${write_mode}" forward "${root}")
        file(READ "${scene}" canonical HEX)
        if(encoding STREQUAL "yaml")
            file(READ "${scene}" yaml_text)
            foreach(runtime_field body_id render_instance_id world_transform previous_position)
                if(yaml_text MATCHES "\"${runtime_field}\"")
                    message(FATAL_ERROR "Runtime field ${runtime_field} leaked into ${scene}")
                endif()
            endforeach()
        endif()
        foreach(order reverse forward)
            if(order STREQUAL "forward")
                run_child("${write_mode}" reverse "${root}")
                file(READ "${scene}" rewritten HEX)
                if(NOT "${canonical}" STREQUAL "${rewritten}")
                    message(FATAL_ERROR "Scene capture depends on component type allocation order: ${root}")
                endif()
            endif()
            # A successful child must actually produce its output, not leave a
            # stale file from a preceding process (e.g. GTEST_FILTER skips it).
            file(REMOVE "${reopened}")
            run_child("${read_mode}" "${order}" "${root}")
            file(READ "${reopened}" actual HEX)
            if(NOT "${canonical}" STREQUAL "${actual}")
                message(FATAL_ERROR "Cross-process scene round trip changed canonical bytes: ${root}")
            endif()
        endforeach()
        message(STATUS "Scene independent-process round trip passed (${kind}, ${encoding}, both type-ID orders)")
        # Binary readers have no YAML source available to fall back to.
        file(REMOVE "${scene}" "${reopened}")
    endforeach()
    file(REMOVE_RECURSE "${root}")
endforeach()
