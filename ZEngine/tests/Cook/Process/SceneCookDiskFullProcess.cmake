cmake_minimum_required(VERSION 3.23)

# Optional native Linux acceptance gate. The caller supplies a dedicated <=16 MiB
# tmpfs (e.g. Docker --tmpfs /bounded:size=2m), never a host disk. The helper checks
# the opened fill file's actual filesystem/capacity before exhausting any space.
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "The bounded native disk-full gate requires Linux tmpfs")
endif()
if(NOT DEFINED TEST_ROOT OR TEST_ROOT STREQUAL "")
    message(FATAL_ERROR "Supply TEST_ROOT on a dedicated tmpfs of at most 16 MiB")
endif()
if(NOT DEFINED HELPER)
    set(HELPER "${CMAKE_CURRENT_LIST_DIR}/SceneCookProcess")
endif()
if(NOT EXISTS "${HELPER}")
    message(FATAL_ERROR "Cook process helper not found: ${HELPER}")
endif()

function(run_child operation root marker)
    execute_process(COMMAND "${HELPER}" "${operation}" "${root}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT result EQUAL 0 OR NOT output MATCHES "${marker}")
        message(FATAL_ERROR "Disk-full process ${operation} failed (${result}), fixture ${root}\n${output}\n${errors}")
    endif()
endfunction()

foreach(phase disk-full disk-full-manifest)
    foreach(kind plain unicode)
        string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef id)
        set(root "${TEST_ROOT}/run-${id}")
        if(kind STREQUAL "unicode")
            string(APPEND root " space é 東京 𠮷")
        endif()
        if(EXISTS "${root}")
            message(FATAL_ERROR "Refusing to reuse disk-full fixture: ${root}")
        endif()
        file(MAKE_DIRECTORY "${root}")
        set(package "${root}/output/desktop-vulkan-le64")
        run_child(write "${root}" ZE_COOK_FIXTURE_WRITTEN)
        file(READ "${package}/manifest.json" previous)
        file(GLOB_RECURSE previous_objects LIST_DIRECTORIES false RELATIVE "${package}" "${package}/objects/*")
        run_child("${phase}" "${root}" ZE_COOK_DISK_FULL_VERIFIED)
        file(READ "${package}/manifest.json" after_failure)
        file(GLOB_RECURSE after_objects LIST_DIRECTORIES false RELATIVE "${package}" "${package}/objects/*")
        file(GLOB scratch "${root}/scratch/*")
        file(GLOB_RECURSE temporary "${package}/*.tmp")
        if(NOT previous STREQUAL after_failure OR temporary OR scratch OR
           EXISTS "${root}/.ze-test-disk-full" OR EXISTS "${package}/.ze-cook-writer.lock")
            message(FATAL_ERROR "ENOSPC changed published state or leaked staging/lock/fill storage: ${root}")
        endif()
        foreach(object IN LISTS previous_objects)
            if(NOT object IN_LIST after_objects)
                message(FATAL_ERROR "ENOSPC removed a previously published object: ${root}/${object}")
            endif()
        endforeach()
        if(phase STREQUAL "disk-full" AND NOT previous_objects STREQUAL after_objects)
            message(FATAL_ERROR "Object-write ENOSPC installed an unverified new object: ${root}")
        endif()
        # Independent consumer hashes all old physical objects, not just filenames.
        run_child(read "${package}" ZE_COOK_PACKAGE_VERIFIED)
        # Reclaiming only this fixture's owned fill file must allow normal retry.
        run_child(changed "${root}" ZE_COOK_FIXTURE_WRITTEN)
        file(READ "${package}/manifest.json" recovered)
        if(previous STREQUAL recovered)
            message(FATAL_ERROR "Retry failed to publish the changed texture: ${root}")
        endif()
        run_child(read-changed "${package}" ZE_COOK_PACKAGE_VERIFIED)
        run_child(repeat "${root}" ZE_COOK_FIXTURE_WRITTEN)
        message(STATUS "Native ENOSPC preserves old package/result, cleans staging and recovers (${phase}, ${kind})")
    endforeach()
endforeach()
