cmake_minimum_required(VERSION 3.23)

# Combined-resource integration, not a shipping CLI or a guessed budget preset.
# Bounded generators write the source fixture; the public cooker performs fresh
# capture/publication, recaptured no-op, forced rebuild and full package checks.
if(NOT DEFINED HELPER)
    set(HELPER "${CMAKE_CURRENT_LIST_DIR}/SceneCookProcess${CMAKE_EXECUTABLE_SUFFIX}")
    if(CMAKE_HOST_WIN32)
        set(HELPER "${CMAKE_CURRENT_LIST_DIR}/SceneCookProcess.exe")
    endif()
endif()
if(NOT EXISTS "${HELPER}")
    message(FATAL_ERROR "Cook helper not found: ${HELPER}")
endif()
if(NOT DEFINED TEST_ROOT)
    set(TEST_ROOT "${CMAKE_CURRENT_BINARY_DIR}/cook-stress-tests")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef id)
set(root "${TEST_ROOT}/run-${id} space é 東京 𠮷")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refusing to reuse stress fixture: ${root}")
endif()
file(MAKE_DIRECTORY "${root}/input" "${root}/workspace")
execute_process(COMMAND "${HELPER}" stress-fixture "${root}/input"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
if(NOT result EQUAL 0 OR NOT output MATCHES "ZE_COOK_STRESS_FIXTURE_WRITTEN")
    message(FATAL_ERROR "Stress fixture generation failed (${result}), retained at ${root}\n${output}\n${errors}")
endif()

file(GLOB_RECURSE inputs LIST_DIRECTORIES false RELATIVE "${root}/input" "${root}/input/*")
set(before "")
foreach(input IN LISTS inputs)
    file(SHA256 "${root}/input/${input}" hash)
    string(APPEND before "${input}:${hash}\n")
endforeach()
execute_process(COMMAND "${HELPER}" smoke-stress "${root}/input/project.json" "${root}/workspace" 268435456
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 480)
if(NOT result EQUAL 0 OR NOT output MATCHES "ZE_COOK_PROJECT_SMOKE_VERIFIED")
    message(FATAL_ERROR "Combined stress cook failed (${result}), retained at ${root}\n${output}\n${errors}")
endif()
if(CMAKE_HOST_SYSTEM_NAME MATCHES "^(Darwin|Linux)$" AND
   NOT output MATCHES "Smoke process-peak-resident-bytes=[1-9][0-9]*")
    message(FATAL_ERROR "Stress cook omitted observational process peak RSS: ${root}\n${output}")
endif()
foreach(category catalog-graph captures codecs staging-manifest diagnostics-result)
    if(NOT output MATCHES "cook-peak-${category}-bytes=[0-9]+")
        message(FATAL_ERROR "Stress cook omitted tracked ${category} peak: ${root}\n${output}")
    endif()
endforeach()
if(NOT output MATCHES "Smoke aggregate capture refusal: preserved=1" OR
   NOT output MATCHES "Smoke staging refusal: preserved=1")
    message(FATAL_ERROR "Stress phase omitted aggregate temporary-storage refusal checks: ${root}\n${output}")
endif()
file(GLOB scratch "${root}/workspace/scratch/*")
file(GLOB_RECURSE temporary "${root}/workspace/output/*.tmp")
if(scratch OR temporary OR EXISTS "${root}/workspace/output/desktop-vulkan-le64/.ze-cook-writer.lock")
    message(FATAL_ERROR "Stress cook leaked scratch, staging or writer ownership: ${root}")
endif()
file(GLOB_RECURSE after_inputs LIST_DIRECTORIES false RELATIVE "${root}/input" "${root}/input/*")
set(after "")
foreach(input IN LISTS after_inputs)
    file(SHA256 "${root}/input/${input}" hash)
    string(APPEND after "${input}:${hash}\n")
endforeach()
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Stress cook changed source files: ${root}")
endif()
file(SHA256 "${root}/workspace/output/desktop-vulkan-le64/manifest.json" manifest)
message(STATUS "Combined stress verified: ${root}; manifest=${manifest}\n${output}")
