cmake_minimum_required(VERSION 3.23)

# Test-only producer/consumer protocol. Installed artifacts need no source tree,
# editor, GPU or original scene/import library. Every helper actually executes
# its phase; a GTEST_FILTER that skips the test cannot pass the protocol marker.
if(NOT DEFINED HELPER)
    set(HELPER "${CMAKE_CURRENT_LIST_DIR}/SceneCookProcess${CMAKE_EXECUTABLE_SUFFIX}")
    if(CMAKE_HOST_WIN32)
        set(HELPER "${CMAKE_CURRENT_LIST_DIR}/SceneCookProcess.exe")
    endif()
endif()
if(NOT EXISTS "${HELPER}")
    message(FATAL_ERROR "Cook process helper not found: ${HELPER}")
endif()
if(NOT DEFINED GOLDEN_ROOT)
    set(GOLDEN_ROOT "${CMAKE_CURRENT_LIST_DIR}/cook-fixtures")
endif()
if(NOT DEFINED TEST_ROOT)
    set(TEST_ROOT "${CMAKE_CURRENT_BINARY_DIR}/cook-process-tests")
endif()
if(NOT DEFINED ROOT_KIND)
    set(ROOT_KIND all)
endif()
if(ROOT_KIND STREQUAL "all")
    set(root_kinds plain unicode)
elseif(ROOT_KIND STREQUAL "plain" OR ROOT_KIND STREQUAL "unicode")
    set(root_kinds "${ROOT_KIND}")
else()
    message(FATAL_ERROR "Unknown ROOT_KIND: ${ROOT_KIND}")
endif()
file(READ "${GOLDEN_ROOT}/package-v1.golden.json" golden_manifest)
file(READ "${GOLDEN_ROOT}/package-v1.inputs.json" golden_inputs)
file(READ "${GOLDEN_ROOT}/package-custom-schema.golden.json" custom_golden)

function(run_child operation root)
    set(child_arguments "${operation}" "${root}")
    if(operation MATCHES "^custom-")
        string(REGEX REPLACE "^custom-" "" phase "${operation}")
        set(child_arguments custom "${phase}" "${root}")
    endif()
    execute_process(COMMAND "${HELPER}" ${child_arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    set(expected_result 0)
    if(operation STREQUAL "interrupt-before")
        set(expected_result 71)
        set(marker ZE_COOK_INTERRUPTED_BEFORE_COMMIT)
    elseif(operation STREQUAL "interrupt-after")
        set(expected_result 72)
        set(marker ZE_COOK_INTERRUPTED_AFTER_COMMIT)
    elseif(operation STREQUAL "busy")
        set(marker ZE_COOK_WRITER_BUSY)
    elseif(operation STREQUAL "corrupt-texture")
        set(marker ZE_COOK_OBJECT_CORRUPTED)
    elseif(operation MATCHES "^custom-reject-(schema|version)$")
        set(marker ZE_COOK_SCHEMA_REJECTION_VERIFIED)
    elseif(operation STREQUAL "custom-reject-migration")
        set(marker ZE_COOK_MIGRATION_REJECTION_VERIFIED)
    elseif(operation MATCHES "^(custom-)?(read|reject)")
        set(marker ZE_COOK_PACKAGE_VERIFIED)
    else()
        set(marker ZE_COOK_FIXTURE_WRITTEN)
    endif()
    if(NOT "${result}" STREQUAL "${expected_result}" OR NOT output MATCHES "${marker}")
        message(FATAL_ERROR "Cook process ${operation} failed (${result}). Fixture retained at ${root}\n${output}\n${errors}")
    endif()
endfunction()

function(check_inputs root)
    string(JSON count LENGTH "${golden_inputs}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON path GET "${golden_inputs}" ${index} path)
        string(JSON expected GET "${golden_inputs}" ${index} sha256)
        string(JSON bytes GET "${golden_inputs}" ${index} bytes)
        set(custom_scene false)
        if(ARGC GREATER 1 AND path MATCHES "^scenes/")
            set(custom_scene true)
            string(JSON path GET "${custom_golden}" source path)
            string(JSON expected GET "${custom_golden}" source sha256)
            string(JSON bytes GET "${custom_golden}" source bytes)
        endif()
        file(SHA256 "${root}/${path}" actual)
        file(SIZE "${root}/${path}" actual_bytes)
        if(NOT actual STREQUAL expected OR NOT actual_bytes EQUAL bytes)
            message(FATAL_ERROR "Captured fixture input changed: ${root}/${path}; expected ${expected}/${bytes}, got ${actual}/${actual_bytes}. Review fixture/contract changes; do not auto-update goldens.")
        endif()
        if(NOT custom_scene AND (path MATCHES "^scenes/" OR path STREQUAL "assets/material.zematerial"))
            file(SHA256 "${GOLDEN_ROOT}/source/${path}" checked_source)
            if(NOT checked_source STREQUAL expected)
                message(FATAL_ERROR "Checked-in source fixture disagrees with its reviewed input digest: ${path}")
            endif()
        endif()
    endforeach()
endfunction()

function(check_custom_manifest root version)
    math(EXPR index "${version} - 1")
    string(JSON expected_version GET "${custom_golden}" versions ${index} schema_version)
    string(JSON expected GET "${custom_golden}" versions ${index} manifest_sha256)
    file(SHA256 "${root}/output/desktop-vulkan-le64/manifest.json" actual)
    if(NOT expected_version EQUAL version OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Custom-schema v${version} package differs from its reviewed golden: ${root}; expected ${expected}, got ${actual}. Review captured inputs and schema/wire changes; never auto-update expectations.")
    endif()
endfunction()

function(check_manifest root)
    file(READ "${root}/output/desktop-vulkan-le64/manifest.json" actual)
    set(expected "${golden_manifest}")
    if(ARGC GREATER 1)
        set(expected "${ARGV1}")
    endif()
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Package bytes differ from reviewed golden: ${root}. Compare input hashes, target, schema and recipe; do not auto-update expectations.")
    endif()
endfunction()

foreach(root_kind IN LISTS root_kinds)
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run_id)
    set(run_root "${TEST_ROOT}/run-${run_id}")
    if(root_kind STREQUAL "unicode")
        string(APPEND run_root " space é 東京 🚀")
    endif()
    if(EXISTS "${run_root}")
        message(FATAL_ERROR "Refusing to reuse cooker test directory: ${run_root}")
    endif()
    file(MAKE_DIRECTORY "${run_root}/first" "${run_root}/reverse")
    set(first "${run_root}/first")
    set(reverse "${run_root}/reverse")
    set(package "${first}/output/desktop-vulkan-le64")

    run_child(write "${first}")
    check_inputs("${first}")
    check_manifest("${first}")
    run_child(repeat "${first}")
    check_manifest("${first}")
    run_child(force "${first}")
    check_manifest("${first}")

    # A separately produced moved checkout/type-ID order must match the SAME golden.
    run_child(write-reverse "${reverse}")
    check_inputs("${reverse}")
    check_manifest("${reverse}")

    # A real application-defined component persists a typed texture UUID/float,
    # but not its runtime cache. It is registered before/after built-ins and gets
    # different real process-local type IDs in independent producers/consumers.
    set(custom_first "${run_root}/custom-first")
    set(custom_reverse "${run_root}/custom-reverse")
    file(MAKE_DIRECTORY "${custom_first}" "${custom_reverse}")
    run_child(custom-write "${custom_first}")
    run_child(custom-write-reverse "${custom_reverse}")
    check_inputs("${custom_first}" custom)
    check_inputs("${custom_reverse}" custom)
    check_custom_manifest("${custom_first}" 1)
    check_custom_manifest("${custom_reverse}" 1)
    file(READ "${custom_first}/output/desktop-vulkan-le64/manifest.json" custom_manifest)
    check_manifest("${custom_reverse}" "${custom_manifest}")
    file(SHA256 "${custom_first}/scenes/scène_東京.scene" custom_source_digest)
    file(SHA256 "${custom_reverse}/scenes/scène_東京.scene" custom_reverse_source_digest)
    if(NOT custom_source_digest STREQUAL custom_reverse_source_digest)
        message(FATAL_ERROR "Custom schema source changed with runtime type-ID/registration order")
    endif()
    file(READ "${custom_first}/scenes/scène_東京.scene" custom_source)
    if(NOT custom_source MATCHES "GameSurface" OR custom_source MATCHES "runtime_cache")
        message(FATAL_ERROR "Custom component was omitted or its runtime cache entered source data")
    endif()
    run_child(custom-repeat "${custom_first}")
    check_manifest("${custom_first}" "${custom_manifest}")
    run_child(custom-force "${custom_first}")
    check_manifest("${custom_first}" "${custom_manifest}")
    file(COPY "${custom_first}/output/desktop-vulkan-le64/" DESTINATION "${run_root}/custom-old")

    # Missing source migration must preserve the old package and caller result,
    # and must not stage/install any additional immutable objects.
    file(GLOB_RECURSE custom_objects_before LIST_DIRECTORIES true RELATIVE "${custom_first}/output/desktop-vulkan-le64" "${custom_first}/output/desktop-vulkan-le64/*")
    run_child(custom-reject-migration "${custom_first}")
    check_manifest("${custom_first}" "${custom_manifest}")
    file(GLOB_RECURSE custom_objects_after LIST_DIRECTORIES true RELATIVE "${custom_first}/output/desktop-vulkan-le64" "${custom_first}/output/desktop-vulkan-le64/*")
    file(GLOB custom_staging "${custom_first}/scratch/*")
    if(NOT custom_objects_before STREQUAL custom_objects_after OR custom_staging)
        message(FATAL_ERROR "Rejected custom migration staged/installed objects or leaked run scratch")
    endif()
    run_child(custom-read "${custom_first}/output/desktop-vulkan-le64")

    # Change only the registered schema version and its source migration. The
    # exact captured v1 source and all asset input/result records must stay equal.
    run_child(custom-schema-change "${custom_first}")
    check_custom_manifest("${custom_first}" 2)
    check_inputs("${custom_first}" custom)
    file(READ "${custom_first}/output/desktop-vulkan-le64/manifest.json" custom_updated)
    string(JSON custom_old_schema GET "${custom_manifest}" schema_key)
    string(JSON custom_new_schema GET "${custom_updated}" schema_key)
    string(JSON custom_old_scene_key GET "${custom_manifest}" scenes 0 input_key)
    string(JSON custom_new_scene_key GET "${custom_updated}" scenes 0 input_key)
    string(JSON custom_old_scene_object GET "${custom_manifest}" scenes 0 object path)
    string(JSON custom_new_scene_object GET "${custom_updated}" scenes 0 object path)
    string(JSON custom_old_assets GET "${custom_manifest}" assets)
    string(JSON custom_new_assets GET "${custom_updated}" assets)
    if(custom_old_schema STREQUAL custom_new_schema OR custom_old_scene_key STREQUAL custom_new_scene_key OR custom_old_scene_object STREQUAL custom_new_scene_object OR NOT custom_old_assets STREQUAL custom_new_assets)
        message(FATAL_ERROR "Custom schema version failed to invalidate its scene or needlessly invalidated asset records")
    endif()
    file(SHA256 "${custom_first}/scenes/scène_東京.scene" custom_source_after)
    if(NOT custom_source_after STREQUAL custom_source_digest)
        message(FATAL_ERROR "Cooked custom migration rewrote authoring source")
    endif()
    run_child(custom-repeat-v2 "${custom_first}")
    check_manifest("${custom_first}" "${custom_updated}")
    run_child(custom-force-v2 "${custom_first}")
    check_manifest("${custom_first}" "${custom_updated}")

    file(REMOVE_RECURSE "${custom_first}/scenes" "${custom_first}/assets" "${custom_first}/_cache"
                        "${custom_reverse}/scenes" "${custom_reverse}/assets" "${custom_reverse}/_cache")
    run_child(custom-read "${run_root}/custom-old")
    run_child(custom-read "${custom_reverse}/output/desktop-vulkan-le64")
    run_child(custom-read-v2 "${custom_first}/output/desktop-vulkan-le64")
    run_child(custom-reject-schema "${run_root}/custom-old")
    run_child(custom-reject-version "${custom_first}/output/desktop-vulkan-le64")

    # The optional offline-project smoke reads editor-style configuration but
    # shares the public cooker, strict package reader and codecs. Source inputs
    # are read-only; destinations are fresh siblings, never inside the project.
    set(smoke_project "${run_root}/smoke-project")
    set(smoke_output "${run_root}/smoke-output")
    file(MAKE_DIRECTORY "${smoke_project}" "${smoke_output}")
    file(COPY "${first}/scenes" "${first}/assets" "${first}/_cache" DESTINATION "${smoke_project}")
    set(smoke_config [=[{"workingSpace":".","sceneDir":"$(workingSpace)/scenes","assetDirs":{"meshDir":"$(workingSpace)/assets"},"sceneList":[{"name":"scène_東京.scene","isDefault":false}]}]=])
    file(WRITE "${smoke_project}/project.json" "${smoke_config}")
    execute_process(COMMAND "${HELPER}" smoke-offline "${smoke_project}/project.json" "${smoke_output}" 16777216
        RESULT_VARIABLE smoke_result OUTPUT_VARIABLE smoke_log ERROR_VARIABLE smoke_error TIMEOUT 40)
    if(NOT smoke_result EQUAL 0 OR NOT smoke_log MATCHES "ZE_COOK_PROJECT_SMOKE_VERIFIED" OR NOT smoke_log MATCHES "recaptured-no-op: scenes=1 assets=4 objects=5")
        message(FATAL_ERROR "Offline project smoke failed (${smoke_result}); retained at ${run_root}\n${smoke_log}\n${smoke_error}")
    endif()
    check_manifest("${smoke_output}")
    check_inputs("${smoke_project}")
    file(READ "${smoke_project}/project.json" smoke_config_after)
    if(NOT smoke_config_after STREQUAL smoke_config)
        message(FATAL_ERROR "Offline project smoke changed its source configuration")
    endif()
    # Reusing a nonempty destination or writing beneath the source project is
    # refused before any cook. Neither path may overwrite an existing package.
    file(MAKE_DIRECTORY "${smoke_project}/forbidden" "${run_root}/smoke-small")
    foreach(refused "${smoke_output}" "${smoke_project}/forbidden")
        execute_process(COMMAND "${HELPER}" smoke-offline "${smoke_project}/project.json" "${refused}" 16777216
            RESULT_VARIABLE refused_result OUTPUT_VARIABLE refused_log ERROR_VARIABLE refused_error TIMEOUT 10)
        if(NOT refused_result EQUAL 2 OR refused_log MATCHES "ZE_COOK_PROJECT_SMOKE_VERIFIED")
            message(FATAL_ERROR "Unsafe smoke destination was not refused: ${refused}\n${refused_log}\n${refused_error}")
        endif()
    endforeach()
    check_manifest("${smoke_output}")
    file(GLOB forbidden_entries "${smoke_project}/forbidden/*")
    if(forbidden_entries)
        message(FATAL_ERROR "Refused smoke destination contains unexpected files")
    endif()
    execute_process(COMMAND "${HELPER}" smoke-offline "${smoke_project}/project.json" "${run_root}/smoke-small" 65536
        RESULT_VARIABLE small_result OUTPUT_VARIABLE small_log ERROR_VARIABLE small_error TIMEOUT 10)
    if(NOT small_result EQUAL 3 OR small_log MATCHES "ZE_COOK_PROJECT_SMOKE_VERIFIED" OR EXISTS "${run_root}/smoke-small/output/desktop-vulkan-le64/manifest.json")
        message(FATAL_ERROR "Insufficient smoke budget did not fail cleanly\n${small_log}\n${small_error}")
    endif()
    # Like SampleProject, the complete batch includes non-default scenes. Never
    # silently select only the default entry from sceneList.
    file(READ "${smoke_project}/scenes/scène_東京.scene" smoke_scene)
    string(REPLACE "10000000-0000-0000-0000-000000000001" "10000000-0000-0000-0000-000000000007" second_smoke_scene "${smoke_scene}")
    file(WRITE "${smoke_project}/scenes/second.zescene" "${second_smoke_scene}")
    string(JSON smoke_multi SET "${smoke_config}" sceneList 1 [=[{"name":"second","isDefault":true}]=])
    file(WRITE "${smoke_project}/project.json" "${smoke_multi}")
    file(MAKE_DIRECTORY "${run_root}/smoke-multi")
    execute_process(COMMAND "${HELPER}" smoke-offline "${smoke_project}/project.json" "${run_root}/smoke-multi" 16777216
        RESULT_VARIABLE multi_result OUTPUT_VARIABLE multi_log ERROR_VARIABLE multi_error TIMEOUT 40)
    if(NOT multi_result EQUAL 0 OR NOT multi_log MATCHES "ZE_COOK_PROJECT_SMOKE_VERIFIED" OR NOT multi_log MATCHES "recaptured-no-op: scenes=2 assets=4 objects=6")
        message(FATAL_ERROR "Complete project scene-list smoke failed (${multi_result})\n${multi_log}\n${multi_error}")
    endif()
    check_inputs("${smoke_project}")

    file(COPY "${package}/" DESTINATION "${run_root}/old-snapshot")
    foreach(boundary before after)
        file(COPY "${first}/" DESTINATION "${run_root}/interrupted-${boundary}")
    endforeach()
    set(snapshot "${run_root}/snapshot")
    file(COPY "${first}/" DESTINATION "${snapshot}")

    run_child(changed "${first}")
    file(READ "${package}/manifest.json" changed_manifest)
    if(changed_manifest STREQUAL golden_manifest)
        message(FATAL_ERROR "Changing only texture bytes did not invalidate the package: ${first}")
    endif()
    foreach(kind_index RANGE 0 3)
        string(JSON kind GET "${golden_manifest}" assets ${kind_index} kind)
        string(JSON old_key GET "${golden_manifest}" assets ${kind_index} input_key)
        string(JSON new_key GET "${changed_manifest}" assets ${kind_index} input_key)
        string(JSON old_object GET "${golden_manifest}" assets ${kind_index} object path)
        string(JSON new_object GET "${changed_manifest}" assets ${kind_index} object path)
        if(kind STREQUAL "environment-map")
            if(NOT old_key STREQUAL new_key OR NOT old_object STREQUAL new_object)
                message(FATAL_ERROR "Unrelated sky stopped being reusable after a texture-only change")
            endif()
        else()
            if(old_key STREQUAL new_key)
                message(FATAL_ERROR "Texture-only change did not invalidate ${kind}'s dependency-result key")
            endif()
            if(kind STREQUAL "mesh")
                if(NOT old_object STREQUAL new_object)
                    message(FATAL_ERROR "Passthrough mesh bytes changed unexpectedly")
                endif()
            elseif(old_object STREQUAL new_object)
                message(FATAL_ERROR "Texture/material output retained a stale content path")
            endif()
        endif()
    endforeach()
    string(JSON old_scene_key GET "${golden_manifest}" scenes 0 input_key)
    string(JSON new_scene_key GET "${changed_manifest}" scenes 0 input_key)
    if(old_scene_key STREQUAL new_scene_key)
        message(FATAL_ERROR "Scene closure key did not reflect its changed texture dependency")
    endif()

    # Remove the source trees BEFORE starting independent consumers. Each reader
    # mounts only its package directory; no YAML/raw source/sidecar fallback exists.
    file(REMOVE_RECURSE "${first}/scenes" "${first}/assets" "${first}/_cache"
                        "${reverse}/scenes" "${reverse}/assets" "${reverse}/_cache")
    run_child(read "${run_root}/old-snapshot")
    run_child(read "${reverse}/output/desktop-vulkan-le64")
    run_child(read-changed "${package}")

    # CMake pipelines execute both children concurrently. The writer waits for
    # the reader's acquired-handle marker, then publishes and signals completion.
    # The reader first reads its OLD handle after replacement and resolves every
    # old dependency in the SAME output root; this is not a copied snapshot.
    execute_process(
        COMMAND "${HELPER}" snapshot-read "${snapshot}/output/desktop-vulkan-le64"
        COMMAND "${HELPER}" snapshot-write "${snapshot}"
        RESULTS_VARIABLE snapshot_results OUTPUT_VARIABLE snapshot_output
        ERROR_VARIABLE snapshot_errors TIMEOUT 40)
    if(NOT snapshot_results STREQUAL "0;0" OR NOT snapshot_output MATCHES "ZE_COOK_FIXTURE_WRITTEN")
        message(FATAL_ERROR "Concurrent manifest snapshot failed (${snapshot_results}). Fixture retained at ${snapshot}\n${snapshot_output}\n${snapshot_errors}")
    endif()
    file(READ "${snapshot}/output/desktop-vulkan-le64/manifest.json" snapshot_manifest)
    if(NOT snapshot_manifest STREQUAL changed_manifest)
        message(FATAL_ERROR "Concurrent writer did not publish the expected changed package")
    endif()
    file(REMOVE_RECURSE "${snapshot}/scenes" "${snapshot}/assets" "${snapshot}/_cache")
    run_child(read-changed "${snapshot}/output/desktop-vulkan-le64")

    # Physical byte failures are not recoverable package-reader cache misses.
    file(COPY "${package}/" DESTINATION "${run_root}/missing")
    file(COPY "${package}/" DESTINATION "${run_root}/corrupt")
    string(JSON texture_path GET "${changed_manifest}" assets 3 object path)
    string(LENGTH "${texture_path}" texture_path_length)
    if(NOT texture_path_length EQUAL 76 OR NOT texture_path MATCHES "^objects/[0-9a-f]+\\.bmp$")
        message(FATAL_ERROR "Refusing to mutate an unexpected fixture texture path: ${texture_path}")
    endif()
    file(REMOVE "${run_root}/missing/${texture_path}")
    run_child(corrupt-texture "${run_root}/corrupt")
    file(SIZE "${run_root}/corrupt/${texture_path}" corrupt_size)
    string(JSON texture_size GET "${changed_manifest}" assets 3 object size)
    if(NOT corrupt_size EQUAL texture_size)
        message(FATAL_ERROR "Corruption probe changed length instead of exercising byte hashing")
    endif()
    run_child(reject-missing "${run_root}/missing")
    run_child(reject-corrupt "${run_root}/corrupt")

    foreach(boundary before after)
        set(interrupted "${run_root}/interrupted-${boundary}")
        set(interrupted_package "${interrupted}/output/desktop-vulkan-le64")
        run_child("interrupt-${boundary}" "${interrupted}")
        file(READ "${interrupted_package}/manifest.json" interrupted_manifest)
        if(boundary STREQUAL "before")
            set(expected_manifest "${golden_manifest}")
            set(reader read)
        else()
            set(expected_manifest "${changed_manifest}")
            set(reader read-changed)
        endif()
        if(NOT interrupted_manifest STREQUAL expected_manifest)
            message(FATAL_ERROR "Abrupt exit ${boundary} commit left the wrong manifest: ${interrupted}")
        endif()
        run_child("${reader}" "${interrupted_package}")
        run_child(busy "${interrupted}")
        file(READ "${interrupted_package}/manifest.json" after_retry)
        if(NOT after_retry STREQUAL interrupted_manifest OR NOT IS_DIRECTORY "${interrupted_package}/.ze-cook-writer.lock")
            message(FATAL_ERROR "Retry stole an interrupted writer lock or changed its package: ${interrupted}")
        endif()
        # Explicit new-root recovery preserves the entire interrupted output,
        # including its stale lock and uncommitted files; no lock is stolen.
        file(RENAME "${interrupted}/output" "${interrupted}/preserved-output")
        file(MAKE_DIRECTORY "${interrupted}/output")
        run_child(rebuild "${interrupted}")
        file(READ "${interrupted_package}/manifest.json" rebuilt_manifest)
        if(NOT rebuilt_manifest STREQUAL changed_manifest)
            message(FATAL_ERROR "New-root recovery did not reproduce the complete changed package")
        endif()
        file(REMOVE_RECURSE "${interrupted}/scenes" "${interrupted}/assets" "${interrupted}/_cache")
        run_child(read-changed "${interrupted_package}")
        run_child("${reader}" "${interrupted}/preserved-output/desktop-vulkan-le64")
    endforeach()

    message(STATUS "Cook independent-process package/golden/invalidation/snapshot/interruption checks passed (${root_kind})")
    # Only directories created by this invocation, never a shared/pre-existing root.
    file(REMOVE_RECURSE "${run_root}")
endforeach()
